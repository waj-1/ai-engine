# WAJ AI Engine — environment variables
#
# Copy to .env for local development. For the self-contained local stack,
# `python deploy/local/gen_env.py` writes deploy/local/.env for you instead.
# Every value below is a placeholder. Commented-out lines show an optional
# variable and its default.

# ─── Required ────────────────────────────────────────────
# The engine refuses to boot without ENVIRONMENT, SUPABASE_URL and
# SUPABASE_ANON_KEY.
ENVIRONMENT=development          # development | staging | production

# The Supabase project that signs users in (auth, the superuser check).
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_KEY=your_service_role_key
# Signature-verified auth (portal, admin MCP, /ai/sessions, /v1/agents)
# checks a token by its own `alg` header:
#   ES256 — against <SUPABASE_URL>/auth/v1/.well-known/jwks.json (nothing to set)
#   HS256 — against SUPABASE_JWT_SECRET
# A token whose key source is missing fails closed (401).
SUPABASE_JWT_SECRET=your_jwt_secret
# SUPABASE_JWKS_URL=              # default derived from SUPABASE_URL
# SUPABASE_JWT_ALGORITHMS=ES256,HS256   # any other value refuses all verified auth

# The engine's own project: agents, prompts, tools, knowledge, evals, chats.
AI_SUPABASE_URL=http://127.0.0.1:54421
AI_SUPABASE_ANON_KEY=your_ai_anon_key
AI_SUPABASE_SERVICE_KEY=your_ai_service_role_key
# Only for the migration / db-functions runner (URL-encode the password).
# Leave it unset in the shell that runs the tests.
# AI_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54422/postgres
# Optional: promote into a separate project per environment (otherwise one
# database, rows told apart by their `environment` column).
# STAGING_AI_SUPABASE_URL=
# STAGING_AI_SUPABASE_SERVICE_KEY=
# PROD_AI_SUPABASE_URL=
# PROD_AI_SUPABASE_SERVICE_KEY=

# ─── Server ──────────────────────────────────────────────
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=INFO
# Browser origins allowed to call the API. Active channels add their own
# origins at boot.
ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*
# RATE_LIMIT_REQUESTS=100         # per client, per window
# RATE_LIMIT_WINDOW=60            # seconds
# Put the exception text in 500 responses. Local debugging only.
# EXPOSE_ERROR_DETAILS=false
# With no admin account yet, the engine shows a first-run page that creates
# one (it asks for the setup code printed in the engine's log at start).
# Set to 0 to turn that page off, for an install whose admin is created some
# other way.
# FIRST_RUN_SETUP=1

# ─── Features (all off by default) ───────────────────────
# Serve POST /v1/agents/{slug}/chat for every `custom` agent. Callers need a
# superuser token for now.
# ENABLE_GENERIC_AGENTS=1
# The demo agent (/v1/agents/demo/chat) is seeded once, on the first start of
# a build with no product plugin and ENABLE_GENERIC_AGENTS on. Set this to
# false to never seed it, or true to seed it on any build.
# SEED_DEMO_AGENT=true
# Mount the admin MCP server at /mcp. Set it on the control-plane only.
# ENABLE_ADMIN_MCP=1
# Superuser-lookup cache for portal + MCP auth, in seconds (0 disables).
# ADMIN_AUTH_CACHE_TTL_SECONDS=60
# Rename the portal shell (sidebar, page titles, login heading).
# PORTAL_NAME=My Agents
# Classify finished conversations into topics. Unset follows ENABLE_ADMIN_MCP.
# CONVERSATION_INSIGHTS=1
# Let MCP servers and HTTP tools point at private/loopback addresses.
# `docker compose up` turns this on for a single machine; set 0 here to turn
# it off on a server other people can reach.
# MCP_ALLOW_LOCAL_ENDPOINTS=0
# Exact host:port entries exempt from the HTTP-tool SSRF block. No scheme, no
# wildcards. Never add a cloud-metadata address.
# HTTP_TOOL_ALLOW_HOSTS=127.0.0.1:8080

# ─── Model providers (set the ones your model rows use) ──
# A key can also be entered in the portal (Settings > Model keys), where it is
# stored encrypted and used before the variable below. That needs SECRET_KEY:
# any long random string. Without it the portal refuses to store a key.
# Losing it makes stored keys unreadable (enter them again). To rotate it use
# SECRET_KEY=new,old, save each key again, then drop the old value.
# deploy/local/gen_env.py and the root docker compose stack generate one.
# SECRET_KEY=change-me-to-a-long-random-string
# GOOGLE_API_KEY=your_google_api_key      # also seeds the demo agents
# OPENAI_API_KEY=your_openai_api_key
# ANTHROPIC_API_KEY=your_anthropic_api_key
# AZURE_OPENAI_API_KEY=your_azure_openai_key
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_API_VERSION=2024-06-01
# A model row can name its own key variable (`auth_env_var`) instead.
# Where an `ollama` model row finds its server when the row sets no base URL.
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# Embeddings for knowledge bases and memory. Default: Gemini (GOOGLE_API_KEY).
# With no cloud key, use any OpenAI-compatible server (Ollama, vLLM, LM
# Studio): the two settings below select it. EMBED_BASE_URL falls back to
# OLLAMA_BASE_URL. Choose before uploading: changing the model later needs
# `python -m scripts.reembed --target kb --apply`.
# EMBED_BASE_URL=http://127.0.0.1:11434/v1
# EMBED_MODEL=nomic-embed-text
# A hosted server's key (or name another variable with EMBED_API_KEY_ENV).
# EMBED_API_KEY=
# Default models and tuning (optional; see core/config.py for every knob).
# AGENT_MAIN_MODEL=
# AGENT_LIGHT_MODEL=
# AGENT_MAX_ITERATIONS=
# AGENT_TOOL_RESULT_CHARS=8000
# AGENT_PROFILE_CACHE_TTL_SEC=60

# ─── Voice ───────────────────────────────────────────────
# Duplex voice (/voice/live) uses the realtime model row's provider:
#   google_genai      → GOOGLE_API_KEY
#   azure_voice_live  → the key named by the row's auth_env_var
# AZURE_VOICE_LIVE_API_KEY=your_voice_live_key
# Speech-to-text / text-to-speech for the voice scenario harness (it speaks
# the simulated caller). The default STT provider is `azure`, which needs the
# key and region; set VOICE_STT_PROVIDER=gemini to use GOOGLE_API_KEY instead.
# AZURE_SPEECH_KEY=your_speech_key
# AZURE_SPEECH_REGION=your_region
# VOICE_STT_PROVIDER=azure
# Per-tenant daily duplex-voice allowance, in audio seconds (read at boot).
# VOICE_LIVE_DAILY_SECONDS=3600
# Allow ?provider=simulated on /voice/live from loopback (voice eval sim runs).
# Control-plane only, never on a public chat app.
# VOICE_LIVE_SIM_ENABLED=1
# Where voice scenario runs place their calls (default: this engine).
# VOICE_SCENARIO_TARGET=ws://127.0.0.1:8000
# Per-call recordings (the Conversations Audio tab).
# VOICE_RECORDING_ENABLED=1
# VOICE_RECORDING_MAX_SEC=900
# VOICE_RECORDING_RETENTION_DAYS=30
# VOICE_RECORDING_SAMPLE_RATE=16000

# ─── Embeddings (knowledge bases, user memory) ───────────
# `google` (default, uses GOOGLE_API_KEY) or `azure` (uses AZURE_OPENAI_*).
# Not a runtime toggle: vectors from different models are not comparable and
# pgvector does not error. Re-embed first:
#   python -m scripts.reembed --target kb|memory --apply
# EMBED_PROVIDER=google
# EMBED_MODEL_GOOGLE=
# AZURE_EMBED_DEPLOYMENT=
# MEMORY_EMBED_MODEL=

# ─── Tracing (optional) ──────────────────────────────────
# Write side: spans go to a Laminar instance. Unset the key, or set
# LMNR_DISABLED=true, to run without tracing (chats are still saved).
# LMNR_PROJECT_API_KEY=your_lmnr_project_api_key
# LMNR_BASE_URL=http://localhost
# LMNR_HTTP_PORT=8001
# LMNR_GRPC_PORT=8002
# LMNR_DISABLED=true
# LMNR_TRACE_CONTENT=true          # false exports spans without prompts/outputs
# Read side: every Conversations / Overview screen queries ClickHouse.
# LMNR_CLICKHOUSE_URL=http://localhost:8123
# LMNR_CLICKHOUSE_USER=clickhouse
# LMNR_CLICKHOUSE_PASSWORD=your_clickhouse_password
# LMNR_CLICKHOUSE_DB=default
# Where to mint the project key; /admin/lmnr/diagnose links to it.
# LMNR_DASHBOARD_URL=http://localhost:5667
# AGENT_TRACE_RECORDER_DISABLED=true  # skip the agent_traces index rows

# ─── Testing ─────────────────────────────────────────────
# Concurrent scenarios per eval run.
# EVAL_CONCURRENCY=
# Base URL test and E2E runs call when no deployment target is registered
# (default: this engine on 127.0.0.1:$PORT). AI_AGENT_BASE_URL_<ENV> overrides
# it per environment.
# AI_AGENT_BASE_URL=http://127.0.0.1:8000

# ─── /agents demo (optional) ─────────────────────────────
# Signs the demo's conversation-state token (derived from a server secret
# when unset).
# AGENTS_PORTAL_SECRET=
# AGENTS_PORTAL_CHAT_PER_MINUTE=20
# AGENTS_PORTAL_CHAT_PER_DAY=400

# ─── CSV exports (optional) ──────────────────────────────
# Large tool results get a CSV download link stored in Azure Blob Storage
# (managed identity, no key). Unset → the agent still returns the rows, with
# no link.
# AZURE_STORAGE_ACCOUNT_URL=https://youraccount.blob.core.windows.net
# AZURE_STORAGE_CONTAINER=csv-exports
# CSV_EXPIRATION_HOURS=24
# GCS_EXPORT_ENABLED=              # legacy name: force the upload on/off

# ─── Portal deploy / rollback buttons (optional) ─────────
# The Deploy screen dispatches deploy-agent-from-portal.yaml and
# rollback-agent.yaml in this repository. You provide those workflows.
# GITHUB_DEPLOY_TOKEN=your_fine_grained_token   # actions:read + actions:write
# GITHUB_DEPLOY_REPO=your-org/your-repo
# The revision picker reads Azure Container Apps revisions:
# AZURE_SUBSCRIPTION_ID=
# ACA_RESOURCE_GROUP=
# ACA_APP_NAME=
